# Copy to .env beside dashboard.py. .env is ignored by Git.
# Restart the Python server after changes. Existing shell variables take priority.
# Never put a real key in this example or in frontend files.
OPENAI_API_KEY=replace_with_a_new_key_from_your_provider
QSHIELD_AI_PROVIDER=openai
QSHIELD_AI_MODEL=gpt-4o-mini
QSHIELD_AI_BASE_URL=https://api.openai.com/v1
QSHIELD_AI_TIMEOUT=30

# Q-Patch protocol: responses (OpenAI default) or chat_completions.
QSHIELD_AI_API=responses

# For AgentRouter / an OpenAI-compatible gateway:
# QSHIELD_AI_PROVIDER=agentrouter
# QSHIELD_AI_BASE_URL=https://YOUR_CONFIRMED_PROVIDER_HOST/v1
# QSHIELD_AI_MODEL=EXACT_MODEL_ID_FROM_YOUR_PROVIDER
# QSHIELD_AI_API=chat_completions
# Use a key issued by that same provider. A gateway key will not authenticate
# against api.openai.com. Chat uses /chat/completions; Q-Patch also requires
# strict JSON schema output support from the selected model and endpoint.
